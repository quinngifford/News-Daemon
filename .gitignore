# Secrets — NEVER commit these.
var/vapid_private.pem
deploy/ticker.env
*.pem
*.key
.env
.env.*

# Runtime state
var/
!var/.gitkeep

# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.ruff_cache/
.pytest_cache/

# Editor / OS
.DS_Store
*.swp

# Xcode — per-user state, never shared. The shared scheme under
# xcshareddata/ is deliberately kept.
ios/**/xcuserdata/
ios/**/*.xcuserstate
ios/build/
ios/DerivedData/
