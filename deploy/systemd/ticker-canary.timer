[Unit]
Description=Weekly external news-ticker drill

[Timer]
OnCalendar=Mon 09:00 UTC
# If the box was asleep or rebooting at the scheduled time, run on next boot
# rather than silently skipping a week.
Persistent=true
RandomizedDelaySec=300
Unit=ticker-canary.service

[Install]
WantedBy=timers.target
