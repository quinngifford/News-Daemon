# Copy to deploy/ticker.env and chmod 600. NEVER commit the real file —
# .gitignore excludes deploy/ticker.env but not this .example.
#
#   cp deploy/ticker.env.example deploy/ticker.env && chmod 600 deploy/ticker.env

# --- Telegram (fastest path to a buzzing phone) ------------------------------
# 1. Message @BotFather → /newbot → copy the token
# 2. Message your bot once, then read your chat id from:
#    https://api.telegram.org/bot<TOKEN>/getUpdates
TICKER_TELEGRAM_TOKEN=
TICKER_TELEGRAM_CHAT_ID=

# --- Outbound to the public app backend -------------------------------------
# The VPS's only outward job. Events are POSTed here, signed with the shared
# secret below. Generate a secret with:  openssl rand -hex 32
# Until both are set, detected events queue in the SQLite outbox and are
# delivered once configured — nothing is lost.
TICKER_WEBHOOK_URL=
TICKER_WEBHOOK_SECRET=

# --- Web Push (PWA) ---------------------------------------------------------
# Generate with: .venv/bin/python tools/gen_vapid_keys.py
# Rotating these invalidates every existing subscription — each device must
# re-enable push or its notifications silently fail with 403.
TICKER_VAPID_PUBLIC_KEY=
TICKER_VAPID_PRIVATE_KEY=

# --- Stage-3 LLM adjudication (optional) ------------------------------------
# Unset = adjudication disabled, Stage-2 score decides alone. Expected real cost
# is cents/month; config/settings.toml caps it hard regardless.
ANTHROPIC_API_KEY=

# --- X filtered stream (optional, ~$1-5/month) ------------------------------
# Read docs/X_API_COSTS.md FIRST. Rules are account-scoped; an unscoped keyword
# rule can cost thousands. Leave blank to keep the adapter disabled at $0.
TICKER_X_BEARER_TOKEN=
